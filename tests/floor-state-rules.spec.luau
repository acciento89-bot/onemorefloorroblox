return function()
	local rules = require("../src/shared/game/FloorStateRules")
	assert(rules.canTransition("Preparing", "Active"), "prepare -> active")
	assert(rules.canTransition("Active", "Success"), "active -> success")
	assert(rules.canTransition("Active", "Failed"), "active -> fail")
	assert(rules.canTransition("Success", "Transition"), "success -> transition")
	assert(rules.canTransition("Transition", "Preparing"), "transition -> prepare")
	assert(rules.canTransition("Failed", "Preparing"), "retry -> prepare")
	assert(not rules.canTransition("Active", "Preparing"), "active cannot reset silently")
	assert(not rules.canTransition("Failed", "Success"), "failure cannot score")
end
