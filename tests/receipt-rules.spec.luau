local ReceiptRules = require("../src/shared/profile/ReceiptRules")
local ProfileRules = require("../src/shared/profile/ProfileRules")

return function()
	local profile = ProfileRules.default()
	local granted, reason = ReceiptRules.apply(profile, "p1", "revive_1", 100)
	assert(granted and reason == "Granted", "revive")
	assert(profile.ReviveCredits == 1, "revive count")
	local duplicate = ReceiptRules.apply(profile, "p1", "revive_1", 100)
	assert(not duplicate, "duplicate")
	assert(profile.ReviveCredits == 1, "duplicate count")
	assert(ReceiptRules.apply(profile, "p2", "skip_1", 100), "skip")
	assert(profile.SkipTokens == 1, "skip count")
	assert(ReceiptRules.apply(profile, "p3", "coin_2x_30m", 100, 1800), "boost")
	assert(profile.CoinMultiplierUntil == 1900, "boost expiry")
	assert(ReceiptRules.apply(profile, "p4", "coin_2x_30m", 200, 1800), "stack")
	assert(profile.CoinMultiplierUntil == 3700, "stack expiry")
	local unknown, unknownReason = ReceiptRules.apply(profile, "p5", "bad", 100)
	assert(not unknown and unknownReason == "UnknownProduct", "unknown")
	assert(profile.ProcessedReceipts.p5 ~= true, "unknown state")
end
